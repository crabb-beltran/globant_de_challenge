# ==============================================================
# Database — PostgreSQL (local Docker Compose or RDS)
# ==============================================================
DB_USER=globant_de_challenge
DB_PASSWORD=changeme
DB_HOST=postgres_rds
DB_PORT=5432
DB_NAME=globant_de_challenge

# ==============================================================
# Test Database — isolated, used only by integration tests
# (tests/integration_conftest.py). Auto-created on first run if
# it doesn't exist. Must be different from DB_NAME — see
# docs/09-testing/testing.md for why isolation is mandatory here.
# ==============================================================
TEST_DB_NAME=globant_test

# ==============================================================
# Backup / Restore — local filesystem path (ADR-012)
# Mounted as a volume in docker-compose.yml (./backups:/app/backups)
# ==============================================================
BACKUP_DIR=/app/backups

# ==============================================================
# AWS — used by LocalStack for local development (Phase 2) and
# by the AWS CLI for real infrastructure provisioning (Phase 3).
# For LocalStack, any placeholder value works (LocalStack does not
# validate real credentials). For real AWS, use your IAM deployer
# user's credentials (see docs/00-project/decisions.md ADR-005 —
# Parameter Store migration is documented deferred work, .env is
# used for local/dev only, never committed).
# ==============================================================
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1